<worksheet xml:id="sec-quiz-one-proportion-ht-att-2">
  <title>Quiz: Inference for One Proportion Part 2 Attempt 2</title>

  <introduction>
    <p>Name: <fillin characters="45"/></p>

    <assemblage>
      <p><em>One-proportion hypothesis test formulas and R commands</em></p>
      <p>
        <m>\widehat{p}=\dfrac{x}{n}</m>
        <m>\qquad</m>
        <m>z=\dfrac{\widehat{p}-p_0}{\sqrt{\dfrac{p_0(1-p_0)}{n}}}</m>
        <m>\qquad</m>
        <m>z^*=qnorm(...)</m>
      </p>
      <p>
        p-value<m>= pnorm(...)</m> or p-value<m>= 2\cdot pnorm(...)</m>
      </p>
    </assemblage>
  </introduction>
    <!-- Source: 1propHT.docx, Question 4; original data, claim, and significance level. -->
    <exercise xml:id="ex-quiz-one-proportion-ht-att-2-zika" workspace="3in">
      <statement>
        <p>
        A researcher claims that at least 83% of Americans believe they are
        unlikely to contract the Zika virus. In a random sample of 215
        Americans, 176 say they are unlikely to contract the virus. Test the
        researcher's claim using a significance level of <m>0.08</m>.
        Is there sufficient evidence to reject the claim?
        </p>
      </statement>
    </exercise>
    <!-- Source: 1propHT.docx, Question 3; original data, claim, and significance level; placebo rate treated as a fixed reference. -->
    <exercise xml:id="ex-quiz-one-proportion-ht-att-2-tamiflu" workspace="3in">
      <statement>
        <p>
        In a clinical trial, 63 of the 708 flu patients treated with Tamiflu
        (oseltamivir phosphate) experienced nausea. Test the claim that the
        nausea rate for Tamiflu users is greater than the 6% rate reported
        for patients given a placebo. Treat 6% as a fixed reference value
        and use a significance level of <m>0.09</m>. Is there sufficient
        evidence to support the claim?
        </p>
      </statement>
    </exercise>
</worksheet>
