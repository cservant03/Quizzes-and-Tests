<worksheet>
  <title>Quiz: Simple and Compound Interest Attempt 2</title>
  <introduction>    
    <p>
      Name: <fillin characters="45"/>
    </p>
    <assemblage>
      <p>
        <md>
          A = P(1 + rt) \qquad
          A = P\left(1 + \frac{r}{n}\right)^{nt} \qquad
          I = A - P
        </md>
      </p>
    </assemblage>
  </introduction>
  
  <exercise workspace="2in">
    <statement>
      <p>A payday loan company charges a $70 fee for a $400 payday loan that will be repaid in 13 days. Treating the fee as interest paid, what is the equivalent annual simple interest rate? Use 360 days in a year. Round to the nearest whole percent.</p>
    </statement>
  </exercise>
  
  <exercise workspace="2in">
    <statement>
      <p>A friend lends you $840, which you agree to repay with 2% annual simple interest. How much will you have to repay your friend if you borrow the money for 5.5 years?</p>
    </statement>
  </exercise>
  
  <exercise workspace="2in">
    <statement>
      <p>You deposit $500 in an account earning 8% annual interest compounded annually. How much will you have in the account in 10 years?</p>
    </statement>
  </exercise>
  
  <exercise workspace="2in">
    <statement>
      <p>How much would you need to deposit in an account now in order to have $3,000 in the account in 5 years? Assume the account earns 7% annual interest compounded monthly.</p>
    </statement>
  </exercise>
</worksheet>
