<worksheet xml:id="sec-quiz-rank-based-voting-att-1">
  <title>Quiz: Rank-Based Voting Methods Attempt 1</title>

  <introduction>
    <p>
      Name: <fillin characters="45"/>
    </p>

    <assemblage>
      <p>
        <m>\binom{n}{2}=\frac{n(n-1)}{2}</m>
      </p>
    </assemblage>
  </introduction>

  <exercise xml:id="ex-quiz-rank-based-voting-att-1-comparison-count" workspace="0.3in">
    <statement>
      <p>
        Seven candidates are running in an election. How many distinct
        pairwise comparisons are needed to compare every candidate with
        every other candidate exactly once?
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-quiz-rank-based-voting-att-1-borda" workspace="1in">
    <statement>
      <p>
        A group of 12 students must decide among three types of pizza: Cheese (C), Mushroom (M), and Pepperoni (P).  The students' preferences are shown below.   Show how the group will make their choice using Borda Count. 
      </p>

      <tabular row-headers="yes"
               halign="center"
               valign="middle"
               top="medium"
               left="medium"
               bottom="medium"
               right="medium">
        <row header="yes" bottom="medium">
          <cell>Number of Students</cell>
          <cell>3</cell>
          <cell>3</cell>
          <cell>2</cell>
          <cell>2</cell>
          <cell>2</cell>
        </row>
        <row>
          <cell>First chioce (2 points)</cell>
          <cell>P</cell>
          <cell>M</cell>
          <cell>C</cell>
          <cell>P</cell>
          <cell>C</cell>
        </row>
        <row>
          <cell>Second choice (1 point)</cell>
          <cell>M</cell>
          <cell>C</cell>
          <cell>M</cell>
          <cell>C</cell>
          <cell>P</cell>
        </row>
        <row>
          <cell>Third choice (0 points)</cell>
          <cell>C</cell>
          <cell>P</cell>
          <cell>P</cell>
          <cell>M</cell>
          <cell>M</cell>
        </row>
      </tabular>
    </statement>
  </exercise>

  <exercise xml:id="ex-quiz-rank-based-voting-att-1-copeland" workspace="2in">
    <statement>
      <p>
        Use the preference schedule to find each candidate's point total
        under Pairwise Comparison (Copeland's Method), and identify the
        winner. Award 1 point for a win, <m>\frac{1}{2}</m> point for a tie,
        and 0 points for a loss in each pairwise comparison.
      </p>

      <tabular row-headers="yes"
               halign="center"
               valign="middle"
               top="medium"
               left="medium"
               bottom="medium"
               right="medium">
        <row header="yes" bottom="medium">
          <cell>Number of voters</cell>
          <cell>10</cell>
          <cell>6</cell>
          <cell>9</cell>
          <cell>7</cell>
        </row>
        <row>
          <cell>1st choice</cell>
          <cell>B</cell>
          <cell>C</cell>
          <cell>D</cell>
          <cell>A</cell>
        </row>
        <row>
          <cell>2nd choice</cell>
          <cell>D</cell>
          <cell>D</cell>
          <cell>A</cell>
          <cell>C</cell>
        </row>
        <row>
          <cell>3rd choice</cell>
          <cell>A</cell>
          <cell>B</cell>
          <cell>C</cell>
          <cell>B</cell>
        </row>
        <row>
          <cell>4th choice</cell>
          <cell>C</cell>
          <cell>A</cell>
          <cell>B</cell>
          <cell>D</cell>
        </row>
      </tabular>
    </statement>
  </exercise>
</worksheet>
