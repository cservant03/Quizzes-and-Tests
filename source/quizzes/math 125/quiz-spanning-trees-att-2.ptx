              </row>
              <row bottom="minor">
                <cell>
                  <em>A</em>
                </cell>
                <cell>
                  <mdash/>
                </cell>
                <cell>11</cell>
                <cell>27</cell>
                <cell>19</cell>
                <cell>12</cell>
                <cell>24</cell>
              </row>
              <row bottom="minor">
