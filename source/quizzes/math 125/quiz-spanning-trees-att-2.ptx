                <cell>42</cell>
                <cell>7</cell>
                <cell>8</cell>
                <cell>36</cell>
              </row>
              <row bottom="minor">
                <cell>
                  <em>C</em>
                </cell>
                <cell>27</cell>
                <cell>42</cell>
                <cell>
                  <mdash/>
                </cell>
                <cell>17</cell>
                <cell>35</cell>
