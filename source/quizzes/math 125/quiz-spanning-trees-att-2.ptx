<?xml version='1.0' encoding='UTF-8'?>
<pretext>
  <docinfo>
    <directories external="../assets"/>
  </docinfo>
  <article xml:id="spanning-trees-quiz-b">
    <title>Spanning Trees Quiz Version B</title>
    <worksheet margin="0.65in" xml:id="quiz-b">
      <title>Spanning Trees Quiz Version B</title>
      <page>
        <p>Name: <fillin characters="30"/> <nbsp/> Date: <fillin characters="12"/></p>
        <p>Show your work. Only labeled dots are vertices; crossings without dots are not vertices.</p>
        <!-- Source: Form 2, Question 5; two original candidate graphs. -->
        <exercise workspace="0.55in" xml:id="quiz-b-q1">
          <statement>
            <p>For each graph below (left and right), determine whether it is a tree. Explain each decision. If a graph is not a tree, identify a cycle or explain why it is disconnected.</p>
            <sidebyside widths="38% 38%" margins="12%">
              <image source="images/quiz-b-q1-left">
                <shortdescription>Graph with vertices A, B, C, D, E, F, G.</shortdescription>
                <description>
                  <p>Edges join these vertex pairs: AF, BD, BF, CE, CG, DF, DG.</p>
                </description>
              </image>
              <image source="images/quiz-b-q1-right">
                <shortdescription>Graph with vertices A, B, C, D, E, F.</shortdescription>
                <description>
                  <p>Edges join these vertex pairs: AB, BD, BE, BF, CF.</p>
                </description>
              </image>
            </sidebyside>
          </statement>
        </exercise>
        <!-- Source: Form 2, Question 6; selection task rewritten as construction. -->
        <exercise workspace="0.4in" xml:id="quiz-b-q2">
          <statement>
            <p>Draw a spanning tree for the graph below. You may mark the retained edges directly on the graph or redraw the tree. List the edges in your tree.</p>
            <image source="images/quiz-b-q2" width="32%">
              <shortdescription>Graph with vertices A, B, C, D, E.</shortdescription>
              <description>
                <p>Edges join these vertex pairs: AC, AD, BC, BD, CE, DE. Some pairs have parallel edges; a spanning tree can use at most one edge from each pair.</p>
              </description>
            </image>
          </statement>
        </exercise>
      </page>
      <page>
        <p><em>Version B continued</em> <nbsp/> Name: <fillin characters="30"/></p>
        <!-- Source: Form 2, Question 7; original graph and weights retained. -->
        <exercise workspace="0.65in" xml:id="quiz-b-q3">
          <statement>
            <p>Use Kruskal's algorithm to find a minimum-weight spanning tree for the graph below. Mark or draw its edges, list them in the order selected, and state the total weight.</p>
            <image source="images/quiz-b-q3" width="52%">
              <shortdescription>Weighted graph with vertices A, B, C, D, E.</shortdescription>
              <description>
                <p>Edge weights: AB = 1, AC = 5, AD = 12, AE = 3, BC = 8, BD = 9, BE = 13, CD = 6, CE = 4, DE = 7.</p>
              </description>
            </image>
          </statement>
        </exercise>
        <!-- Source: Form 2, Question 3; original table retained exactly. -->
        <exercise workspace="1.15in" xml:id="quiz-b-q4">
          <statement>
            <p>The table gives the edge weights of a graph. Use Kruskal's algorithm to find a minimum-cost spanning tree. List the edges in the order selected, and calculate the total cost.</p>
            <tabular halign="center" valign="middle" top="minor" bottom="minor" left="minor" right="minor">
              <col right="minor"/>
              <col right="minor"/>
              <col right="minor"/>
              <col right="minor"/>
              <col right="minor"/>
              <col right="minor"/>
              <col right="minor"/>
              <row bottom="minor" header="yes">
                <cell/>
                <cell>
                  <em>A</em>
                </cell>
                <cell>
                  <em>B</em>
                </cell>
                <cell>
                  <em>C</em>
                </cell>
                <cell>
                  <em>D</em>
                </cell>
                <cell>
                  <em>E</em>
                </cell>
                <cell>
                  <em>F</em>
                </cell>
              </row>
              <row bottom="minor">
                <cell>
                  <em>A</em>
                </cell>
                <cell>
                  <mdash/>
                </cell>
                <cell>11</cell>
                <cell>27</cell>
                <cell>19</cell>
                <cell>12</cell>
                <cell>24</cell>
              </row>
              <row bottom="minor">
                <cell>
                  <em>B</em>
                </cell>
                <cell>11</cell>
                <cell>
                  <mdash/>
                </cell>
                <cell>42</cell>
                <cell>7</cell>
                <cell>8</cell>
                <cell>36</cell>
              </row>
              <row bottom="minor">
                <cell>
                  <em>C</em>
                </cell>
                <cell>27</cell>
                <cell>42</cell>
                <cell>
                  <mdash/>
                </cell>
                <cell>17</cell>
                <cell>35</cell>
                <cell>41</cell>
              </row>
              <row bottom="minor">
                <cell>
                  <em>D</em>
                </cell>
                <cell>19</cell>
                <cell>7</cell>
                <cell>17</cell>
                <cell>
                  <mdash/>
                </cell>
                <cell>40</cell>
                <cell>32</cell>
              </row>
              <row bottom="minor">
                <cell>
                  <em>E</em>
                </cell>
                <cell>12</cell>
                <cell>8</cell>
                <cell>35</cell>
                <cell>40</cell>
                <cell>
                  <mdash/>
                </cell>
                <cell>5</cell>
              </row>
              <row bottom="minor">
                <cell>
                  <em>F</em>
                </cell>
                <cell>24</cell>
                <cell>36</cell>
                <cell>41</cell>
                <cell>32</cell>
                <cell>5</cell>
                <cell>
                  <mdash/>
                </cell>
              </row>
            </tabular>
          </statement>
        </exercise>
      </page>
    </worksheet>
  </article>
</pretext>
