<worksheet>
  <title>Quiz: Scheduling Attempt 1</title>
  
  <introduction>
    <p>
      Name: <fillin characters="45"/>
    </p>

    <assemblage>
      <title>Scheduling Algorithms</title>
      <sidebyside widths="60% 35%" valigns="top top">
        <stack>
          <p><em>List Processing</em></p>
          <p>
            <ol>
              <li>
                <p>Mark every ready task.</p>
              </li>
              <li>
                <p>Give each processor the first ready task in the priority list. Mark that task as in progress so it is not assigned twice.</p>
              </li>
              <li>
                <p>If an available processor has no ready task, leave it idle.</p>
              </li>
            </ol>
          </p>
        </stack>
        <stack>
          <p><em>Decreasing Time</em></p>
          <p>
            <ol>
              <li>
                <p>Create a priority list by arranging tasks from longest <em>individual duration</em> to shortest.</p>
              </li>
              <li>
                <p>Break ties by placing the smaller task number first.</p>
              </li>
              <li>
                <p>Use that list with the list processing algorithm for the stated number of processors.</p>
              </li>
            </ol>
          </p>
        </stack>
      </sidebyside>
    </assemblage>
  </introduction>
  
  <exercise workspace = "0.5in">
    <statement>
      <p>Use the decreasing-time algorithm to create a priority list for the digraph below. Then schedule the project with two processors.</p>
      <image source="/images/quiz-a-q2-form-2-q5" width="60%">
        <shortdescription>Project digraph with 10 tasks. Task times and prerequisites are given in the detailed description.</shortdescription>
        <description>
          <p>Each node is labeled with its task number and the time required in parentheses. Arrows indicate prerequisites. End marks completion of the project and has no duration.</p>
          <tabular halign="left">
            <col width="15%"/>
            <col width="23%"/>
            <col width="62%"/>
            <row header="yes" bottom="minor">
              <cell>Task</cell>
              <cell>Time required</cell>
              <cell>Immediate prerequisites</cell>
            </row>
            <row>
              <cell>
                <m>T_1</m>
              </cell>
              <cell>4</cell>
              <cell>None</cell>
            </row>
            <row>
              <cell>
                <m>T_2</m>
              </cell>
              <cell>8</cell>
              <cell>None</cell>
            </row>
            <row>
              <cell>
                <m>T_3</m>
              </cell>
              <cell>10</cell>
              <cell>None</cell>
            </row>
            <row>
              <cell>
                <m>T_4</m>
              </cell>
              <cell>11</cell>
              <cell>None</cell>
            </row>
            <row>
              <cell>
                <m>T_5</m>
              </cell>
              <cell>5</cell>
              <cell>
                <m>T_1, T_2</m>
              </cell>
            </row>
            <row>
              <cell>
                <m>T_6</m>
              </cell>
              <cell>6</cell>
              <cell>
                <m>T_2</m>
              </cell>
            </row>
            <row>
              <cell>
                <m>T_7</m>
              </cell>
              <cell>9</cell>
              <cell>
                <m>T_3</m>
              </cell>
            </row>
            <row>
              <cell>
                <m>T_8</m>
              </cell>
              <cell>2</cell>
              <cell>
                <m>T_6, T_7</m>
              </cell>
            </row>
            <row>
              <cell>
                <m>T_9</m>
              </cell>
              <cell>7</cell>
              <cell>
                <m>T_5</m>
              </cell>
            </row>
            <row>
              <cell>
                <m>T_10</m>
              </cell>
              <cell>3</cell>
              <cell>
                <m>T_5, T_8</m>
              </cell>
            </row>
          </tabular>
        </description>
      </image>
      <image source="/images/schedule-2proc-40time.svg" width="90%">
        <shortdescription>A schedule with two processors that goes to 40 time units.</shortdescription>
      </image>
    </statement>
  </exercise>

  <exercise>
    <introduction>
      <p>Using the priority list <m>T_1, T_7, T_8, T_6, T_5, T_9, T_4, T_2, T_3</m>, schedule the project below with two processors.</p>
      <tabular halign="left">
        <col width="15%"/>
        <col width="23%"/>
        <col width="62%"/>
        <row header="yes" bottom="minor">
          <cell>Task</cell>
          <cell>Time required</cell>
          <cell>Tasks that must be completed first</cell>
        </row>
        <row>
          <cell>
            <m>T_1</m>
          </cell>
          <cell>7</cell>
          <cell>None</cell>
        </row>
        <row>
          <cell>
            <m>T_2</m>
          </cell>
          <cell>3</cell>
          <cell>None</cell>
        </row>
        <row>
          <cell>
            <m>T_3</m>
          </cell>
          <cell>12</cell>
          <cell>None</cell>
        </row>
        <row>
          <cell>
            <m>T_4</m>
          </cell>
          <cell>8</cell>
          <cell>
            <m>T_2</m>
          </cell>
        </row>
        <row>
          <cell>
            <m>T_5</m>
          </cell>
          <cell>10</cell>
          <cell>
            <m>T_1, T_2, T_3</m>
          </cell>
        </row>
        <row>
          <cell>
            <m>T_6</m>
          </cell>
          <cell>10</cell>
          <cell>
            <m>T_2, T_3</m>
          </cell>
        </row>
        <row>
          <cell>
            <m>T_7</m>
          </cell>
          <cell>2</cell>
          <cell>
            <m>T_4</m>
          </cell>
        </row>
        <row>
          <cell>
            <m>T_8</m>
          </cell>
          <cell>6</cell>
          <cell>
            <m>T_4, T_5</m>
          </cell>
        </row>
        <row>
          <cell>
            <m>T_9</m>
          </cell>
          <cell>9</cell>
          <cell>
            <m>T_6</m>
          </cell>
        </row>
      </tabular>      
      <image source="/images/schedule-2proc-40time.svg" width="90%">
        <shortdescription>A schedule with two processors that goes to 40 time units.</shortdescription>
      </image>
    </introduction>
  </exercise>
</worksheet>