<worksheet>
  <title>Quiz: Sets Attempt 3</title>
  <introduction>
    <p>
      Name: <fillin characters="45"/>
    </p>
  </introduction>

  <!-- Source: sets.docx, question 4. -->
  <exercise>
    <introduction>
      <p>
        Let <m>S = \{1,2,3,\ldots,20\}</m> be the universal set. Let
        <m>A</m> and <m>B</m> be subsets of <m>S</m>, where
        <md>
          <mrow>A &amp;= \{1,2,6,8,10,12,13,14,17,18,19,20\}</mrow>
          <mrow>B &amp;= \{4,5,6,8,13,16,17\}.</mrow>
        </md>
      </p>
    </introduction>
    <task workspace="1in">
      <statement>
        <p>List the elements of <m>A \cap B^{c}</m>.</p>
      </statement>
    </task>
    <task workspace="1in">
      <statement>
        <p>List the elements of <m>B \cap A^{c}</m>.</p>
      </statement>
    </task>
  </exercise>

  <!-- Source: sets.docx, question 8. -->
  <exercise workspace="2in">
    <statement>
      <p>
        Let <m>S = \{1,2,3,\ldots,20\}</m> be the universal set. Let
        <m>A</m>, <m>B</m>, and <m>C</m> be subsets of <m>S</m>, where
        <md>
          <mrow>A &amp;= \{1,2,3,4,6,7,10,13,17,18,20\},</mrow>
          <mrow>B &amp;= \{4,5,7,9,12,15\},</mrow>
          <mrow>C &amp;= \{1,3,4,11,14,15,16,19,20\}.</mrow>
        </md>
        Find the number of elements in <m>(A \cap C) \cap B^{c}</m>.
      </p>
    </statement>
  </exercise>

  <!-- Source: sets.docx, question 11. -->
  <exercise workspace="2in">
    <statement>
      <p>
        Suppose set <m>A</m> contains 50 elements and <m>A \cup B</m> contains
        54 elements. If <m>A</m> and <m>B</m> have 28 elements in common,
        how many elements are contained in set <m>B</m>?
      </p>
    </statement>
  </exercise>

  <!-- Source: sets.docx, question 18. -->
  <exercise workspace="2in">
    <statement>
      <p>
        In a survey of 99 pet owners, 50 said they own a dog, and 25 said they
        own a cat. Twenty-one said they own both a dog and a cat. How many owned
        a cat but not a dog?
      </p>
    </statement>
  </exercise>
</worksheet>
