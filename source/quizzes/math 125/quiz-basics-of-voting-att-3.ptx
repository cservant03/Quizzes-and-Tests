<worksheet xml:id="sec-quiz-basics-of-voting-att-3">
  <title>Quiz: Basics of Voting Attempt 3</title>

  <introduction>
    <p>
      Name: <fillin characters="45"/>
    </p>
  </introduction>

  <!-- Source: voting.docx, HW: Basics of Voting - Form 1, Question 3. -->
  <exercise xml:id="ex-quiz-basics-of-voting-att-3-preference-schedule" workspace="0.01in">
    <statement>
      <p>
        Here is the preference schedule for a recent election among four
        candidates:
      </p>

      <tabular row-headers="yes"
               halign="center"
               valign="middle"
               top="medium"
               left="medium"
               bottom="medium"
               right="medium">
        <row header="yes" bottom="medium">
          <cell>Number of voters</cell>
          <cell>5</cell>
          <cell>10</cell>
          <cell>10</cell>
          <cell>1</cell>
          <cell>15</cell>
          <cell>10</cell>
          <cell>2</cell>
        </row>
        <row>
          <cell>1st choice</cell>
          <cell>G</cell>
          <cell>A</cell>
          <cell>D</cell>
          <cell>C</cell>
          <cell>G</cell>
          <cell>G</cell>
          <cell>C</cell>
        </row>
        <row>
          <cell>2nd choice</cell>
          <cell>A</cell>
          <cell>C</cell>
          <cell>A</cell>
          <cell>A</cell>
          <cell>D</cell>
          <cell>C</cell>
          <cell>G</cell>
        </row>
        <row>
          <cell>3rd choice</cell>
          <cell>C</cell>
          <cell>D</cell>
          <cell>G</cell>
          <cell>D</cell>
          <cell>C</cell>
          <cell>D</cell>
          <cell>A</cell>
        </row>
        <row>
          <cell>4th choice</cell>
          <cell>D</cell>
          <cell>G</cell>
          <cell>C</cell>
          <cell>G</cell>
          <cell>A</cell>
          <cell>A</cell>
          <cell>D</cell>
        </row>
      </tabular>

      <ol marker="a)">
        <li>
          <p>How many voters voted in this election?</p>
        </li>
        <li>
          <p>How many first-place votes are needed for a majority?</p>
        </li>
        <li>
          <p>Which candidate had the most first-place votes?</p>
        </li>
        <li>
          <p>Which candidate had the fewest first-place votes?</p>
        </li>
        <li>
          <p>Which candidate had the most last-place votes?</p>
        </li>
        <li>
          <p>Which candidate had the fewest last-place votes?</p>
        </li>
      </ol>
    </statement>
  </exercise>

  <!-- Source: voting.docx, HW: Basics of Voting - Form 1, Question 10. -->
  <exercise xml:id="ex-quiz-basics-of-voting-att-3-condorcet-criterion" workspace="0.01in">
    <statement>
      <p>
        You read in a local newspaper opinion section that <q>candidate Smith
        was preferred in every head-to-head comparison, yet still lost the
        election. How is that fair?</q>
      </p>
      <p>Which fairness criterion is this referring to?</p>
      <ol marker="A.">
        <li><p>The Condorcet Criterion</p></li>
        <li><p>The Majority Criterion</p></li>
        <li><p>The Monotonicity Criterion</p></li>
        <li><p>The Independence of Irrelevant Alternatives Criterion</p></li>
        <li><p>None of these</p></li>
      </ol>
    </statement>
  </exercise>

  <!-- Source: voting.docx, HW: Basics of Voting - Form 1, Question 13. -->
  <exercise xml:id="ex-quiz-basics-of-voting-att-3-majority-criterion">
    <statement>
      <p>
        An election resulted in Candidate A winning, with Candidate B coming
        in a close second, and Candidate C being a distant third.
      </p>
      <p>
        If B had received a majority of first-place votes, which is the
        primary fairness criterion violated in this election?
      </p>
      <ol marker="A.">
        <li><p>Condorcet Criterion</p></li>
        <li><p>Independence of Irrelevant Alternatives Criterion</p></li>
        <li><p>Majority Criterion</p></li>
        <li><p>Monotonicity Criterion</p></li>
      </ol>
    </statement>
  </exercise>
</worksheet>
